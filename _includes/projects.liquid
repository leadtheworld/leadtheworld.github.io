<div class="col project-card-item" data-keywords="{{ project.keywords | join: '|' | downcase | strip }}">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if project.paper or project.doi or project.video or project.website or project.github %}
          <div class="mb-2">
            {% if project.paper %}
              <a
                href="{% if project.paper contains '://' %}{{ project.paper }}{% else %}{{ project.paper | relative_url }}{% endif %}"
                class="btn btn-outline-secondary btn-sm mr-1 mb-1"
                target="_blank"
                rel="noopener noreferrer"
                >Paper</a
              >
            {% endif %}
            {% if project.doi %}
              {% assign doi_url = project.doi %}
              {% unless doi_url contains '://' %}
                {% assign doi_url = 'https://doi.org/' | append: project.doi %}
              {% endunless %}
              <a href="{{ doi_url }}" class="btn btn-outline-secondary btn-sm mr-1 mb-1" target="_blank" rel="noopener noreferrer">DOI</a>
            {% endif %}
            {% if project.video %}
              <a
                href="{% if project.video contains '://' %}{{ project.video }}{% else %}{{ project.video | relative_url }}{% endif %}"
                class="btn btn-outline-secondary btn-sm mr-1 mb-1"
                target="_blank"
                rel="noopener noreferrer"
                >Video</a
              >
            {% endif %}
            {% if project.website %}
              <a
                href="{% if project.website contains '://' %}{{ project.website }}{% else %}{{ project.website | relative_url }}{% endif %}"
                class="btn btn-outline-secondary btn-sm mr-1 mb-1"
                target="_blank"
                rel="noopener noreferrer"
                >Website</a
              >
            {% endif %}
          </div>
        {% endif %}
        {% if project.collaborator or project.venue or project.keywords %}
          <div class="mt-2 small text-muted">
            {% if project.collaborator %}
              <div><strong>With:</strong> {{ project.collaborator }}</div>
            {% endif %}
            {% if project.venue %}
              <div><strong>Venue:</strong> {{ project.venue }}</div>
            {% endif %}
            {% if project.keywords %}
              <div class="project-keywords">
                {% for keyword in project.keywords %}
                  <span class="badge badge-pill badge-secondary mr-1 mb-1">{{ keyword }}</span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
        <div class="row ml-1 mr-1 p-0">
          {% if project.github %}
            <div class="github-icon">
              <div class="icon" data-toggle="tooltip" title="Code Repository">
                <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
              </div>
              {% if project.github_stars %}
                <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                  <i class="fa-solid fa-star"></i>
                  <span id="{{ project.github_stars }}-stars"></span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </a>
</div>
