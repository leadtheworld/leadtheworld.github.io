<style>
  footer .footer-notice,
  footer .footer-notice strong,
  footer .footer-notice a {
    color: #b0b0b0 !important;
  }

  footer .footer-notice a {
    text-decoration: none !important;
  }

  footer .footer-notice a:hover {
    color: #d0d0d0 !important;
    text-decoration: underline !important;
  }
</style>

{% capture footer_contents %}
  <span class="footer-notice">
    <strong>
      Planning to apply for Ph.D. programs starting in Fall 2028.<br>
      Research or collaboration inquiries are welcome at
      <a href="mailto:leadtheworld@g.skku.edu?subject=Research%20or%20Collaboration%20Inquiry">
        leadtheworld@g.skku.edu
      </a>.
    </strong>
  </span>
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
