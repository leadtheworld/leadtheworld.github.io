<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>
      {% unless page.permalink == '/' %}{{ page.title | escape }} · {% endunless %}
      Nahyun Lee
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <meta property="og:title" content="{{ page.title | default: 'Nahyun Lee' | escape }}">
    <meta property="og:description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ '/assets/img/nahyunlee.jpg' | absolute_url }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/assets/img/atlas-mark.svg' | relative_url }}" type="image/svg+xml">
    <link rel="preload" href="{{ '/assets/fonts/k2d/K2D-Regular.ttf' | relative_url }}" as="font" type="font/ttf" crossorigin>
    <link rel="stylesheet" href="{{ '/assets/css/atlas.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/atlas-theme.css' | relative_url }}">
    <script src="{{ '/assets/js/atlas-ui.js' | relative_url }}" defer></script>
  </head>
  <body data-page="{{ page.section | default: 'blog' }}" data-baseurl="{{ site.baseurl }}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="{{ '/' | relative_url }}" aria-label="Nahyun Lee, home"
        ><span class="wordmark-icon" aria-hidden="true">n.</span> Nahyun Lee</a
      >
      <nav class="main-nav" aria-label="Main navigation">
        <a
          href="{{ '/' | relative_url }}"
          {% if page.section == 'home' %}
            aria-current="page"
          {% endif %}
          >Home</a
        >
        <a
          href="{{ '/cv/' | relative_url }}"
          {% if page.section == 'cv' %}
            aria-current="page"
          {% endif %}
          >CV</a
        >
        <a
          href="{{ '/publications/' | relative_url }}"
          {% if page.section == 'publications' %}
            aria-current="page"
          {% endif %}
          >Publications</a
        >
        <a
          href="{{ '/blog/' | relative_url }}"
          {% if page.section == 'blog' or page.layout == 'atlas-post' %}
            aria-current="page"
          {% endif %}
          >Blog</a
        >
      </nav>
      <a class="header-contact" href="mailto:leadtheworld@g.skku.edu">Get in touch <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main">{{ content }}</main>
    <footer class="site-footer collaborations-footer" aria-label="Site footer">
      <div class="footer-identity page-width">
        <div>
          <a class="footer-name" href="{{ '/' | relative_url }}">Nahyun Lee</a>
          <p class="footer-tagline"><em>Augmenting how we perceive the world.</em></p>
        </div>
        <div class="footer-links">
          <a href="mailto:leadtheworld@g.skku.edu"><span class="social-icon icon-email" aria-hidden="true"></span>Email</a>
          <a href="https://www.linkedin.com/in/leadtheworld/"><span class="social-icon icon-linkedin" aria-hidden="true"></span>LinkedIn ↗</a>
          <a href="https://scholar.google.com/citations?user=11pN9C4AAAAJ"
            ><span class="social-icon icon-scholar" aria-hidden="true"></span>Scholar ↗</a
          >
          <a href="https://github.com/leadtheworld"><span class="social-icon icon-github" aria-hidden="true"></span>GitHub ↗</a>
        </div>
      </div>
      <div class="page-width collaborations-intro">
        <h2 id="collaborations-title">Research Collaborations</h2>
        <p>
          I’m always <strong>open to research collaborations.</strong> <a class="text-link" href="mailto:leadtheworld@g.skku.edu">Let’s talk ↗</a>
        </p>
      </div>
      <div class="page-width collaboration-logos">
        <ul class="collaboration-logo-grid" aria-labelledby="collaborations-title">
          {% for institution in site.data.atlas_institutions %}
            <li class="institution-item institution-{{ institution.id }}">
              <a href="{{ institution.url }}" target="_blank" rel="noopener noreferrer">
                <span class="institution-logo logo-fit-{{ institution.fit }}"
                  ><img src="{{ institution.image | relative_url }}" alt="{{ institution.name | escape }}" width="230" height="82" loading="lazy"
                ></span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </footer>
  </body>
</html>
