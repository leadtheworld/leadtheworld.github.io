---
layout: atlas
---
{% assign pub = site.data.atlas_publications | where: 'id', page.publication_id | first %}
{% assign project = site.data.atlas.projects | where: 'id', pub.project | first %}
<article class="page-width inner-page post-page publication-detail">
  <a class="back-link" href="{{ '/publications/' | relative_url }}">← All publications</a>
  <header class="post-title">
    <p class="publication-status">
      {{ pub.status -}}
      {%- if pub.year %} · {{ pub.year }}{% endif %}
    </p>
    <h1>{{ pub.title }}</h1>
    <p class="publication-authors">
      {% for author in pub.authors -%}
        {%- if author == 'Nahyun Lee' -%}
          <strong>{{ author }}</strong>
        {%- else -%}
          {{- author -}}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor %}
    </p>
    {% if pub.venue != '' %}
      <p class="publication-venue">{{ pub.venue }}</p>
    {% endif %}
    <p class="post-deck">{{ pub.summary }}</p>
    <div class="inline-links">
      {% if pub.url != '' -%}
        <a class="button solid" href="{{ pub.url }}" target="_blank" rel="noopener noreferrer">
          {%- if pub.url contains 'drive.google.com' %}Read manuscript{% else %}Read paper{% endif %} ↗</a
        >
      {%- endif %}
    </div>
    <div class="method-tags">
      {% for method in project.methods -%}
        <span>{{ method }}</span>
      {%- endfor %}
    </div>
  </header>
  <div class="post-body">{{ content }}</div>
  {% if project.publications.size > 1 %}
    <section class="post-related">
      <h2>Related publications</h2>
      {% for id in project.publications -%}
        {%- unless id == pub.id %}
          {% assign related = site.data.atlas_publications | where: 'id', id | first %}
          <a href="{{ related.permalink | relative_url }}">{{ related.title }} ↗</a>
        {% endunless -%}
      {%- endfor %}
    </section>
  {% endif %}
  {% assign stories = site.posts | where: 'project_id', project.id %}
  {% if stories.size > 0 %}
    <section class="post-related">
      <h2>Beyond the paper</h2>
      {% for story in stories -%}
        <a href="{{ story.url | relative_url }}">{{ story.title }} ↗</a>
      {%- endfor %}
    </section>
  {% endif %}
  <div class="post-ending"><a class="text-link" href="{{ '/#research-atlas' | relative_url }}">Back to the research globe ↗</a></div>
</article>
